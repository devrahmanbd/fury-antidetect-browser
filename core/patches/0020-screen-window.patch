+// Fury patch 0020: outerWidth and outerHeight are the window's size, and a
+// persona's window has the chrome of the persona's OS around it, not the
+// host's. So the rect every frame of a page is told is the top-level page's
+// viewport plus the persona's chrome (screen.chromeWidthDelta and
+// chromeHeightDelta), at the window's real position.
+//
+// It used to be the renderer adding the chrome to the frame's own innerWidth.
+// That holds in the page and nowhere else: an iframe got its own box plus the
+// chrome, 300x289 for a default 300x150 iframe beside 1004x748 in the page,
+// measured on the Windows build box on 24.10.2026, where real Chrome gives the
+// page's pair in every frame. Taking the page's viewport from the top-level
+// view here gives a cross-site iframe in another process the same pair, and
+// from its first script: the renderer's own copy of the page's viewport
+// reaches such a frame only after it has started running (measured 0x0 at
+// load). It also leaves outerWidth alone when the page is zoomed, as a real
+// window does, where innerWidth + chrome shrank with the zoom.
+//
+// A phone persona's window is its screen, which the renderer answers for
+// (patch 0131), and a widget that is not a frame (a <select> popup) keeps its
+// real rect.
+gfx::Rect RenderWidgetHostImpl::FuryWindowScreenRect() {
+  gfx::Rect window = view_->GetBoundsInScreenWithoutTransform();
+  const fury::FuryConfig* config = fury::FuryConfig::Get();
+  if (!config || config->GetBool("mobile.enabled").value_or(false) ||
+      (!owner_delegate_ && !view_->IsRenderWidgetHostViewChildFrame())) {
+    return window;
+  }
+  RenderWidgetHostViewBase* root = view_->GetRootView();
+  if (!root) {
+    return window;
+  }
+  gfx::Size viewport = root->GetViewBoundsWithoutTransform().size();
+  if (viewport.IsEmpty()) {
+    return window;
+  }
+  if (std::optional<int> delta = config->GetInt("screen.chromeWidthDelta");
+      delta && *delta >= 0) {
+    window.set_width(viewport.width() + *delta);
+  }
+  if (std::optional<int> delta = config->GetInt("screen.chromeHeightDelta");
+      delta && *delta >= 0) {
+    window.set_height(viewport.height() + *delta);
+  }
+  return window;
+}
