+void Canvas2DRecorderContext::FuryNoteDraw(
+    const CanvasRenderingContext2DState& state,
+    CanvasRenderingContext2DState::PaintType paint_type,
+    CanvasPerformanceMonitor::DrawType draw_type,
+    const gfx::RectF& bounds) {
+  CanvasRenderingContextHost* host = GetCanvasRenderingContextHost();
+  if (!host) {
+    return;
+  }
+  using DrawType = CanvasPerformanceMonitor::DrawType;
+  bool platform_dependent = true;
+  if (draw_type == DrawType::kImageData) {
+    // putImageData: the page's own bytes, copied.
+    platform_dependent = false;
+  } else if (draw_type == DrawType::kRectangle &&
+             paint_type == CanvasRenderingContext2DState::kFillPaintType) {
+    // fillRect is exact only in the plain case: a solid colour, fully
+    // opaque, source-over, on whole pixels, with nothing blurred. Any
+    // antialiased edge, blend, gradient, pattern, shadow or filter is
+    // rasteriser arithmetic, and that differs between machines.
+    const CanvasStyle& style = state.Style(paint_type);
+    const AffineTransform& t = state.GetTransform();
+    const bool whole_pixels =
+        t.IsIdentityOrTranslation() && t.E() == std::round(t.E()) &&
+        t.F() == std::round(t.F()) && bounds.x() == std::round(bounds.x()) &&
+        bounds.y() == std::round(bounds.y()) &&
+        bounds.right() == std::round(bounds.right()) &&
+        bounds.bottom() == std::round(bounds.bottom());
+    platform_dependent =
+        !whole_pixels || style.GetCanvasGradient() ||
+        style.GetCanvasPattern() || state.ShouldDrawShadows() ||
+        state.IsFilterUnresolved() || state.IsFilterResolved() ||
+        state.GlobalAlpha() != 1.0 ||
+        state.GlobalComposite() != SkBlendMode::kSrcOver;
+  }
+  host->FuryNoteDraw(platform_dependent);
 }
 
